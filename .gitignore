# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment to ignore the Asset Store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache / user files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio Code (keep shared settings if desired)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Rider
.idea/

# Unity generated project files
*.csproj
*.unityproj
*.sln
*.slnx
*.tmp
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Debug symbols
*.pdb
*.mdb

# Gradle / Android
/[Aa]ssets/Plugins/Android/*.tmp
*.keystore

# Addressables / Burst / generated
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*
/[Aa]ssets/StreamingAssets/BuildReport/
*.burst-debug

# Code coverage / test results
/[Cc]ode[Cc]overage/
TestResults/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
